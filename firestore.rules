rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { 
      return request.auth != null; 
    }
    function me() { 
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data; 
    }
    function isManager() { 
      return signedIn() && me().role == 'manager'; 
    }
    function isActive() { 
      return signedIn() && me().status == 'active'; 
    }

    match /users/{uid} {
      allow read: if isActive();
      allow create: if isManager();
      allow delete: if isManager();
      // User may update ONLY safe self-presence fields
      allow update: if isManager() ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['fcmTokens','presence','lastSeen','deviceId','isDoNotDisturb']));
    }

    match /userIndex/{id} { 
      allow read: if signedIn(); 
      allow write: if isManager(); 
    }

    match /groups/{id} { 
      allow read: if isActive(); 
      allow write: if isManager(); 
    }

    match /settings/{id} { 
      allow read: if signedIn(); 
      allow write: if isManager(); 
    }

    match /calls/{callId} {
      allow create: if isActive() && request.resource.data.callerUid == request.auth.uid;
      allow read, update: if isActive() && (
        resource.data.callerUid == request.auth.uid || 
        request.auth.uid in resource.data.calleeUids || 
        isManager()
      );
      match /{sub}/{doc} { 
        allow read, write: if isActive(); 
      }
    }

    match /callLogs/{id} {
      allow read: if isActive() && (resource.data.ownerUid == request.auth.uid || isManager());
      allow create: if isActive();
      allow delete: if isManager() || resource.data.ownerUid == request.auth.uid;
    }
  }
}
